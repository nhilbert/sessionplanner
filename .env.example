# Copy to .env (gitignored) for local overrides. Nothing here is needed to run locally.
# SP_PORT=5175
# SP_DATA_DIR=data

# Hosting behind the login proxy (docs/concept.md, sections 8 and 11). Leave unset locally.
# The Dockerfile already sets SP_HOST=0.0.0.0 and SP_DATA_DIR=/data.
# SP_PUBLIC_URL=https://sessions.example.com   # its host and origin pass the API guard
# SP_OWNERS=you@example.com                    # required with SP_PUBLIC_URL: e-mail(s) the login proxy lets in
# SP_OWNER_HEADER=x-auth-request-email         # header the proxy sets with the signed-in e-mail
# SP_GUESTS_FILE=/config/login/sessions-emails.txt  # the login's allow-list (read-only): offered when sharing

# AI agents over MCP (docs/mcp.md). Without both, /mcp is off; npm run mcp (stdio) works regardless.
# SP_MCP_OAUTH=1                               # OAuth for Claude's connectors; hosted, the owners (SP_OWNERS) approve connections
# SP_MCP_TOKEN=                                # static bearer token for /mcp (openssl rand -hex 32), for clients without OAuth
# SP_OAUTH_REDIRECTS=                          # extra redirect URIs clients may register (Claude's callbacks and loopback are always allowed)

# Read-only workshop list for the CRM, which links deliveries to workshops (docs/concept.md, section 11, "Link list").
# SP_LINK_TOKEN=                               # bearer token for GET /api/link/workshops (openssl rand -hex 32); unset = off
